{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["app.ts"],
  "project": ["**/*.ts", "**/*.mjs", "!**/*.d.ts", "!node_modules/**"],
  "ignoreDependencies": ["html-validate", "postcss-html", "stylelint-config-standard"],
  "treatConfigHintsAsErrors": true,
  "rules": { "cycles": "error" },
  "includeEntryExports": true,
  "typescript": {
    "config": ["tsconfig.json", "tsconfig.test.json"]
  }
}
