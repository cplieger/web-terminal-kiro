{
  "type": "module",
  "scripts": {
    "typecheck": "tsc -project tsconfig.json",
    "typecheck:tests": "tsc -project tsconfig.test.json",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "lint:knip": "knip",
    "lint:stylelint": "stylelint --configBasedir . --config stylelint-html.json '../static/*.html'",
    "test:e2e": "playwright test --config playwright.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.6.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/browser": "5.0.3",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.11.0",
    "html-validate": "11.16.1",
    "knip": "6.39.0",
    "playwright": "1.63.0",
    "postcss-html": "2.0.0",
    "prettier": "3.9.9",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@cplieger/web-terminal-engine": "6.0.4",
    "@cplieger/web-terminal-ui": "8.3.1"
  },
  "overrides": {
    "qs": "^6.15.2",
    "playwright-core": "$playwright"
  }
}
